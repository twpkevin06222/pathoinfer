{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCard",
  "$defs": {
    "ClassInfo": {
      "additionalProperties": false,
      "description": "One class. ``id`` is its output channel (segmentation, classification) or label\n(detection); ``color`` is its display colour.",
      "properties": {
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Color",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "color"
      ],
      "title": "ClassInfo",
      "type": "object"
    },
    "ClassificationCard": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "framework": {
          "enum": [
            "onnx",
            "torch",
            "tensorrt",
            "safetensors"
          ],
          "title": "Framework",
          "type": "string"
        },
        "file": {
          "description": "Model file, relative to the model folder.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "precision": {
          "default": "fp32",
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "int8",
            "fp8"
          ],
          "title": "Precision",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/ClassInfo"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "recommended_overlap": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Recommended Overlap",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "training_run_id": null,
            "calibration_set_hash": null,
            "parent_model": null,
            "parity": null,
            "source_metadata": {}
          }
        },
        "task": {
          "const": "classification",
          "title": "Task",
          "type": "string"
        },
        "background_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Class id of tiles that are not a finding (e.g. normal); null if none.",
          "title": "Background Id"
        },
        "output": {
          "$ref": "#/$defs/ClassificationOutput"
        }
      },
      "required": [
        "name",
        "version",
        "framework",
        "file",
        "input",
        "classes",
        "recommended_overlap",
        "task",
        "background_id",
        "output"
      ],
      "title": "ClassificationCard",
      "type": "object"
    },
    "ClassificationOutput": {
      "additionalProperties": false,
      "description": "One ``(batch, n_classes)`` tensor per tile; column ``i`` is class id ``i``.",
      "properties": {
        "tensor": {
          "default": "logits",
          "title": "Tensor",
          "type": "string"
        },
        "activation": {
          "enum": [
            "logits",
            "probs"
          ],
          "title": "Activation",
          "type": "string"
        },
        "n_classes": {
          "exclusiveMinimum": 0,
          "title": "N Classes",
          "type": "integer"
        }
      },
      "required": [
        "activation",
        "n_classes"
      ],
      "title": "ClassificationOutput",
      "type": "object"
    },
    "DetectionCard": {
      "additionalProperties": false,
      "description": "Every detection label is a foreground class, so there is no background id.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "framework": {
          "enum": [
            "onnx",
            "torch",
            "tensorrt",
            "safetensors"
          ],
          "title": "Framework",
          "type": "string"
        },
        "file": {
          "description": "Model file, relative to the model folder.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "precision": {
          "default": "fp32",
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "int8",
            "fp8"
          ],
          "title": "Precision",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/ClassInfo"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "recommended_overlap": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Recommended Overlap",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "training_run_id": null,
            "calibration_set_hash": null,
            "parent_model": null,
            "parity": null,
            "source_metadata": {}
          }
        },
        "task": {
          "const": "detection",
          "title": "Task",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/DetectionOutput"
        }
      },
      "required": [
        "name",
        "version",
        "framework",
        "file",
        "input",
        "classes",
        "recommended_overlap",
        "task",
        "output"
      ],
      "title": "DetectionCard",
      "type": "object"
    },
    "DetectionOutput": {
      "additionalProperties": false,
      "description": "Three tensors, one row per detection: boxes ``(batch, n, 4)``, scores ``(batch, n)``\nand labels ``(batch, n)`` holding class ids; optionally ``class_probs``\n``(batch, n, n_classes)``, each detection's probability per class.",
      "properties": {
        "boxes": {
          "default": "boxes",
          "title": "Boxes",
          "type": "string"
        },
        "scores": {
          "default": "scores",
          "title": "Scores",
          "type": "string"
        },
        "labels": {
          "default": "labels",
          "title": "Labels",
          "type": "string"
        },
        "box_format": {
          "enum": [
            "xyxy",
            "cxcywh"
          ],
          "title": "Box Format",
          "type": "string"
        },
        "box_units": {
          "enum": [
            "pixel",
            "normalised"
          ],
          "title": "Box Units",
          "type": "string"
        },
        "score_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score Threshold",
          "type": "number"
        },
        "class_probs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Probs"
        }
      },
      "required": [
        "box_format",
        "box_units",
        "score_threshold"
      ],
      "title": "DetectionOutput",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "description": "The tile the model takes: ``tile_size`` px square, read at ``mpp``.",
      "properties": {
        "name": {
          "default": "image",
          "title": "Name",
          "type": "string"
        },
        "tile_size": {
          "exclusiveMinimum": 0,
          "title": "Tile Size",
          "type": "integer"
        },
        "mpp": {
          "exclusiveMinimum": 0,
          "title": "Mpp",
          "type": "number"
        },
        "channel_order": {
          "default": "RGB",
          "enum": [
            "RGB",
            "BGR"
          ],
          "title": "Channel Order",
          "type": "string"
        },
        "layout": {
          "default": "NCHW",
          "enum": [
            "NCHW",
            "NHWC"
          ],
          "title": "Layout",
          "type": "string"
        },
        "dtype": {
          "default": "float32",
          "enum": [
            "float32",
            "float16",
            "uint8"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "normalisation": {
          "$ref": "#/$defs/Normalisation"
        },
        "icc": {
          "default": true,
          "description": "Convert the slide's ICC profile to sRGB first.",
          "title": "Icc",
          "type": "boolean"
        }
      },
      "required": [
        "tile_size",
        "mpp",
        "normalisation"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "Normalisation": {
      "additionalProperties": false,
      "description": "Per channel, in ``channel_order``: ``(pixel * scale - mean) / std``.",
      "properties": {
        "mean": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Mean",
          "type": "array"
        },
        "std": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Std",
          "type": "array"
        },
        "scale": {
          "default": 0.00392156862745098,
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "std"
      ],
      "title": "Normalisation",
      "type": "object"
    },
    "Parity": {
      "additionalProperties": false,
      "description": "How a converted model matched its full-precision reference through the real\nstitchers. Written only when every metric was within its tolerance.",
      "properties": {
        "reference": {
          "description": "name@version of the full-precision model compared.",
          "title": "Reference",
          "type": "string"
        },
        "tile_set_hash": {
          "description": "Hash of the tiles both models ran on.",
          "title": "Tile Set Hash",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Worst value of each metric over classes, e.g. dice_min, f1_min, auc_min.",
          "title": "Metrics",
          "type": "object"
        },
        "tolerances": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "The bound each metric had to meet.",
          "title": "Tolerances",
          "type": "object"
        },
        "checked_at": {
          "description": "UTC time of the check, ISO 8601.",
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "tile_set_hash",
        "metrics",
        "tolerances",
        "checked_at"
      ],
      "title": "Parity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "training_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Run Id"
        },
        "calibration_set_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Set Hash"
        },
        "parent_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name@version of the model this one was converted from.",
          "title": "Parent Model"
        },
        "parity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Parity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parity with the reference model, for converted models."
        },
        "source_metadata": {
          "additionalProperties": true,
          "default": {},
          "description": "Producer metadata kept as is, e.g. a legacy 'pathotrain' ONNX key.",
          "title": "Source Metadata",
          "type": "object"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "SegmentationCard": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "framework": {
          "enum": [
            "onnx",
            "torch",
            "tensorrt",
            "safetensors"
          ],
          "title": "Framework",
          "type": "string"
        },
        "file": {
          "description": "Model file, relative to the model folder.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "precision": {
          "default": "fp32",
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "int8",
            "fp8"
          ],
          "title": "Precision",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/ClassInfo"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "recommended_overlap": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Recommended Overlap",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "training_run_id": null,
            "calibration_set_hash": null,
            "parent_model": null,
            "parity": null,
            "source_metadata": {}
          }
        },
        "task": {
          "const": "segmentation",
          "title": "Task",
          "type": "string"
        },
        "background_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Class id of background, never written as an annotation; null if none.",
          "title": "Background Id"
        },
        "output": {
          "$ref": "#/$defs/SegmentationOutput"
        }
      },
      "required": [
        "name",
        "version",
        "framework",
        "file",
        "input",
        "classes",
        "recommended_overlap",
        "task",
        "background_id",
        "output"
      ],
      "title": "SegmentationCard",
      "type": "object"
    },
    "SegmentationOutput": {
      "additionalProperties": false,
      "description": "One ``(batch, n_classes, H, W)`` tensor; channel ``i`` is class id ``i``.",
      "properties": {
        "tensor": {
          "default": "logits",
          "title": "Tensor",
          "type": "string"
        },
        "activation": {
          "enum": [
            "logits",
            "probs"
          ],
          "title": "Activation",
          "type": "string"
        },
        "n_classes": {
          "exclusiveMinimum": 0,
          "title": "N Classes",
          "type": "integer"
        }
      },
      "required": [
        "activation",
        "n_classes"
      ],
      "title": "SegmentationOutput",
      "type": "object"
    },
    "VqaCard": {
      "additionalProperties": false,
      "description": "A vision-language model answering questions about slide crops, as a Hugging Face\nmodel folder (``config.json``, safetensors shards, processor files) that vLLM serves.\n``precision`` is the language model's weights (``int4`` for W4A16); the vision\nencoder and projector stay bf16.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "task": {
          "const": "vqa",
          "title": "Task",
          "type": "string"
        },
        "framework": {
          "const": "hf",
          "default": "hf",
          "title": "Framework",
          "type": "string"
        },
        "file": {
          "const": "config.json",
          "default": "config.json",
          "title": "File",
          "type": "string"
        },
        "architecture": {
          "description": "transformers class, e.g. Qwen3VLForConditionalGeneration.",
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "precision": {
          "default": "bf16",
          "enum": [
            "bf16",
            "fp16",
            "fp8",
            "int8",
            "int4"
          ],
          "title": "Precision",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/VqaInput"
        },
        "output": {
          "$ref": "#/$defs/VqaOutput",
          "default": {
            "grounding": false,
            "box_format": "xyxy",
            "box_units": "per_mille"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "training_run_id": null,
            "calibration_set_hash": null,
            "parent_model": null,
            "parity": null,
            "source_metadata": {}
          }
        }
      },
      "required": [
        "name",
        "version",
        "task",
        "architecture",
        "input"
      ],
      "title": "VqaCard",
      "type": "object"
    },
    "VqaInput": {
      "additionalProperties": false,
      "description": "How the slide crops a VLM sees are made: ``tile_size`` px squares read at ``mpp``\n(ICC-converted when ``icc``); ``max_pixels`` caps what the processor resizes to.",
      "properties": {
        "tile_size": {
          "exclusiveMinimum": 0,
          "title": "Tile Size",
          "type": "integer"
        },
        "mpp": {
          "exclusiveMinimum": 0,
          "title": "Mpp",
          "type": "number"
        },
        "max_pixels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pixels"
        },
        "icc": {
          "default": true,
          "title": "Icc",
          "type": "boolean"
        }
      },
      "required": [
        "tile_size",
        "mpp"
      ],
      "title": "VqaInput",
      "type": "object"
    },
    "VqaOutput": {
      "additionalProperties": false,
      "description": "``grounding``: the model answers with boxes, in ``box_format`` and ``box_units``\n(``per_mille``: 0-1000 of the image, as Qwen-VL; ``normalised``: 0-1; ``pixel``).",
      "properties": {
        "grounding": {
          "default": false,
          "title": "Grounding",
          "type": "boolean"
        },
        "box_format": {
          "default": "xyxy",
          "enum": [
            "xyxy",
            "cxcywh"
          ],
          "title": "Box Format",
          "type": "string"
        },
        "box_units": {
          "default": "per_mille",
          "enum": [
            "pixel",
            "normalised",
            "per_mille"
          ],
          "title": "Box Units",
          "type": "string"
        }
      },
      "title": "VqaOutput",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "classification": "#/$defs/ClassificationCard",
      "detection": "#/$defs/DetectionCard",
      "segmentation": "#/$defs/SegmentationCard",
      "vqa": "#/$defs/VqaCard"
    },
    "propertyName": "task"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SegmentationCard"
    },
    {
      "$ref": "#/$defs/DetectionCard"
    },
    {
      "$ref": "#/$defs/ClassificationCard"
    },
    {
      "$ref": "#/$defs/VqaCard"
    }
  ]
}
